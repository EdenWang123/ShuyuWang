---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const chapters = [
  {
    authors: 'Wang, S., Ness, I. J., Greiff, S., & Kaufman, J. C.',
    year:    '2026',
    title:   "Generative AI's Impact on Creativity and Equity: Another Great Equalizer or the Rich Get Richer?",
    venue:   'In M. Worwood & J. C. Kaufman (Eds.), Generative Artificial Intelligence and Creativity: Possibilities, Precautions, and Perspectives',
    publisher: 'Academic Press',
  },
];

const presentations = [
  {
    authors: 'Wang, S. & Wang, Y.',
    year:    '2025',
    month:   'March',
    title:   "How can Generative Artificial Intelligence work to foster students' creativity? A Systematic Review and Meta-Analysis",
    type:    'Poster',
    venue:   'APA Division 10 · New Haven, CT, USA',
  },
  {
    authors: 'Wang, Y. & Wang, S.',
    year:    '2025',
    month:   'April',
    title:   "How Generative Artificial Intelligence (GAI) be used in higher education: A systematic review",
    type:    'Presentation',
    venue:   'AERA · Denver, CO, USA',
  },
  {
    authors: 'Wang, S.',
    year:    '2025',
    month:   'May',
    title:   'Learning wisely in the age of Artificial Intelligence era',
    type:    'Presentation',
    venue:   '13th Annual Teaching and Learning with Technology Conference · Storrs, CT, USA',
  },
  {
    authors: 'Wilson, J. & Wang, S.',
    year:    '2025',
    month:   'November',
    title:   'Beyond ChatGPT: Practical tools for sparking creative thinking in gifted learners',
    type:    'Presentation',
    venue:   'NACG · Pittsburgh, PA',
  },
];

const inPreparation = [
  {
    authors: 'Wang, S. & Kaufman, J. C.',
    title:   'Assessing fan fiction for creativity',
  },
  {
    authors: 'Wang, S. & Kaufman, J. C.',
    title:   'A textual analysis of fan fiction',
  },
  {
    authors: 'Wang, Y. & Wang, S.',
    title:   'The perspective of higher education users for Generative Artificial Intelligence (GAI): A systematic review',
  },
  {
    authors: 'Wang, S. & Wang, Y.',
    title:   "Can Generative Artificial Intelligence improve students' creativity? A systematic review and meta-analysis",
  },
  {
    authors: 'Wang, S. & Wilson, J.',
    title:   'How can we adopt AI into creativity assessment: A systematic review',
  },
];
---

<Layout title="Research — Eden Wang">
  <Nav />

  <!-- ══════════════════════════════════
       PAGE HEADER
  ══════════════════════════════════ -->
  <section class="pt-32 pb-0 max-w-7xl mx-auto px-6 md:px-10">
    <p class="issue-label text-muted mb-3">Research · Publications</p>
    <div class="rule-bold mb-10"></div>

    <div class="grid grid-cols-12 gap-8 items-end pb-20">
      <div class="col-span-12 md:col-span-7">
        <h1 class="text-display">RESEARCH<br /><span class="text-accent italic">WORK</span></h1>
      </div>
      <div class="col-span-12 md:col-span-5">
        <p class="text-subhead text-muted leading-relaxed">
          Peer-reviewed publications, conference presentations,<br />
          and ongoing manuscripts.
        </p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════
       BOOK CHAPTERS
  ══════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 pb-20">
    <div class="flex items-baseline gap-6 mb-2">
      <p class="slugline">Book Chapters</p>
      <span class="font-mono text-xs text-border">{chapters.length}</span>
    </div>
    <div class="rule-bold mb-10"></div>

    {chapters.map((pub, i) => (
      <div class="grid grid-cols-12 gap-6 py-10 border-b border-border reveal">
        <div class="col-span-12 md:col-span-1">
          <p class="font-mono text-3xl font-bold text-border select-none">
            {String(i + 1).padStart(2, '0')}
          </p>
        </div>
        <div class="col-span-12 md:col-span-8">
          <p class="font-serif text-xl font-bold leading-snug mb-3">{pub.title}</p>
          <p class="text-muted text-sm leading-relaxed">{pub.authors} ({pub.year}).<br />
            <em>{pub.venue}</em>. {pub.publisher}.
          </p>
        </div>
        <div class="col-span-12 md:col-span-3 text-right">
          <span class="inline-block border border-accent text-accent px-3 py-1 text-xs font-mono uppercase tracking-widest">
            {pub.year}
          </span>
        </div>
      </div>
    ))}
  </section>

  <!-- ══════════════════════════════════
       PRESENTATIONS
  ══════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 pb-20">
    <div class="flex items-baseline gap-6 mb-2">
      <p class="slugline">Presentations</p>
      <span class="font-mono text-xs text-border">{presentations.length}</span>
    </div>
    <div class="rule-bold mb-10"></div>

    {presentations.map((pub, i) => (
      <div class="grid grid-cols-12 gap-6 py-10 border-b border-border reveal">
        <div class="col-span-12 md:col-span-1">
          <p class="font-mono text-3xl font-bold text-border select-none">
            {String(i + 1).padStart(2, '0')}
          </p>
        </div>
        <div class="col-span-12 md:col-span-8">
          <p class="font-serif text-xl font-bold leading-snug mb-2">{pub.title}</p>
          <p class="text-muted text-sm">{pub.authors}</p>
          <p class="text-muted text-xs mt-2">{pub.type} · {pub.venue}</p>
        </div>
        <div class="col-span-12 md:col-span-3 text-right">
          <span class="inline-block border border-border text-muted px-3 py-1 text-xs font-mono uppercase tracking-widest">
            {pub.month} {pub.year}
          </span>
        </div>
      </div>
    ))}
  </section>

  <!-- ══════════════════════════════════
       MANUSCRIPTS IN PREPARATION
  ══════════════════════════════════ -->
  <section class="bg-ink text-cream py-24">
    <div class="max-w-7xl mx-auto px-6 md:px-10">
      <div class="flex items-baseline gap-6 mb-2">
        <p class="slugline text-accent">Manuscripts in Preparation</p>
        <span class="font-mono text-xs text-cream/20">{inPreparation.length}</span>
      </div>
      <div class="border-t border-cream/20 mb-12"></div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {inPreparation.map((ms, i) => (
          <div class="border border-cream/10 p-6 reveal">
            <p class="font-mono text-4xl font-bold text-cream/10 mb-4 select-none">
              {String(i + 1).padStart(2, '0')}
            </p>
            <p class="font-serif text-lg font-bold leading-snug mb-3">{ms.title}</p>
            <p class="text-cream/50 text-xs">{ms.authors}</p>
            <p class="text-accent text-xs mt-2 font-mono uppercase tracking-widest">In preparation</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
