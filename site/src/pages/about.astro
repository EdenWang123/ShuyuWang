---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const education = [
  {
    degree: 'Ph.D. in Educational Psychology',
    school: 'University of Connecticut',
    years:  '2023 – Present',
    note:   'Giftedness, Creativity & Talent Development',
  },
  {
    degree: 'M.S. in Research Methods, Measurement & Evaluation',
    school: 'University of Connecticut',
    years:  '2025 – Present',
    note:   '',
  },
  {
    degree: 'M.S. in Educational Technology',
    school: 'Missouri State University',
    years:  '2020 – 2021',
    note:   '',
  },
  {
    degree: 'M.A. in Curriculum and Instruction',
    school: 'Hainan Normal University, China',
    years:  '2018 – 2021',
    note:   '',
  },
  {
    degree: 'B.A. in Pre-school Education',
    school: 'Jilin Normal University, China',
    years:  '2013 – 2017',
    note:   '',
  },
];

const interests = [
  { label: 'Creativity & AI',         desc: 'How generative AI tools reshape and augment human creative processes.' },
  { label: 'Fan Fiction Studies',      desc: 'Fan fiction as a rich site for studying creative expression and narrative thinking.' },
  { label: 'Gifted Education',         desc: 'Talent identification, development, and equity in gifted programs.' },
  { label: 'Educational Technology',   desc: 'Innovation in learning design, digital tools, and instructional systems.' },
];

const awards = [
  { year: '2025', title: "Neag School's Peg Beecher-Hlavacek Scholarship", amount: '$500' },
  { year: '2025', title: 'Graduate School Travel Fund',                    amount: '$750' },
  { year: '2021', title: 'Excellent Graduation Thesis · Hainan Province',  amount: '' },
];
---

<Layout title="About — Eden Wang">
  <Nav />

  <!-- ══════════════════════════════════
       PAGE HEADER
  ══════════════════════════════════ -->
  <section class="pt-32 pb-0 max-w-7xl mx-auto px-6 md:px-10">
    <p class="issue-label text-muted mb-3">About · Eden Wang</p>
    <div class="rule-bold mb-10"></div>

    <div class="grid grid-cols-12 gap-8 items-end">
      <div class="col-span-12 md:col-span-8">
        <h1 class="text-display">SHUYU<br /><span class="text-accent italic">(EDEN)</span><br />WANG</h1>
      </div>
      <div class="col-span-12 md:col-span-4">
        <div class="border-l border-border pl-6 pb-2">
          <p class="text-subhead leading-snug">
            "Creativity is not the exclusive province<br />
            of the few — it is the right of the many."
          </p>
          <p class="issue-label text-muted mt-4">Research Philosophy</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════
       BIO
  ══════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 py-20">
    <div class="grid grid-cols-12 gap-12">
      <div class="col-span-12 md:col-span-7 reveal">
        <p class="slugline mb-4">Profile</p>
        <p class="font-serif text-xl leading-relaxed mb-5">
          I am a Ph.D. student in Educational Psychology at the University of Connecticut,
          working in the area of Giftedness, Creativity, and Talent Development under
          Professor James Kaufman.
        </p>
        <p class="text-muted text-sm leading-relaxed mb-5">
          My research sits at the intersection of creativity science and emerging technology.
          I investigate how generative AI tools — from ChatGPT to image generators — interact
          with human creative capacity: sometimes expanding it, sometimes constraining it,
          and always transforming it. A particular focus of mine is equity: do these tools
          level the creative playing field, or do they widen existing gaps?
        </p>
        <p class="text-muted text-sm leading-relaxed">
          I also study fan fiction as a lens for understanding everyday creativity. Fan fiction
          communities produce enormous quantities of creative writing, making them an ideal
          population for studying how ordinary people express and develop creative voice.
        </p>
      </div>

      <div class="col-span-12 md:col-span-5 reveal reveal-delay-1">
        <p class="slugline mb-4">Contact</p>
        <div class="space-y-3">
          <div>
            <p class="issue-label text-muted">Email</p>
            <a href="mailto:Shuyu.Wang@uconn.edu"
               class="font-sans text-sm hover:text-accent transition-colors duration-200">
              Shuyu.Wang@uconn.edu
            </a>
          </div>
          <div>
            <p class="issue-label text-muted">Phone</p>
            <p class="font-sans text-sm">+1 (413) 321-4547</p>
          </div>
          <div>
            <p class="issue-label text-muted">Affiliation</p>
            <p class="font-sans text-sm">University of Connecticut<br />Department of Educational Psychology</p>
          </div>
        </div>

        <div class="mt-10">
          <p class="slugline mb-4">Skills</p>
          <div class="space-y-2 text-sm">
            <div>
              <p class="issue-label text-muted">Quantitative</p>
              <p>Python · R · SPSS</p>
            </div>
            <div>
              <p class="issue-label text-muted">Qualitative</p>
              <p>NVivo</p>
            </div>
            <div>
              <p class="issue-label text-muted">Educational</p>
              <p>Blackboard</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════
       RESEARCH INTERESTS
  ══════════════════════════════════ -->
  <section class="bg-ink text-cream py-24">
    <div class="max-w-7xl mx-auto px-6 md:px-10">
      <p class="slugline text-accent mb-3">Research Interests</p>
      <div class="border-t border-cream/20 mb-12"></div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-cream/20">
        {interests.map((item, i) => (
          <div class="bg-ink p-8 reveal">
            <p class="font-mono text-4xl font-bold text-cream/10 mb-4 select-none">
              {String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="font-serif text-xl font-bold mb-3">{item.label}</h3>
            <p class="text-cream/60 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════
       EDUCATION TIMELINE
  ══════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 py-24">
    <p class="slugline mb-3">Education</p>
    <div class="rule-bold mb-12"></div>

    <div class="space-y-0">
      {education.map((edu, i) => (
        <div class={`grid grid-cols-12 gap-4 py-8 ${i < education.length - 1 ? 'border-b border-border' : ''} reveal`}>
          <div class="col-span-12 md:col-span-3">
            <p class="font-mono text-xs text-muted">{edu.years}</p>
          </div>
          <div class="col-span-12 md:col-span-6">
            <p class="font-serif text-lg font-bold leading-snug">{edu.degree}</p>
            {edu.note && <p class="text-accent text-sm mt-1 italic">{edu.note}</p>}
          </div>
          <div class="col-span-12 md:col-span-3">
            <p class="text-muted text-sm">{edu.school}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════
       TEACHING
  ══════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 pb-24">
    <div class="grid grid-cols-12 gap-12">
      <div class="col-span-12 md:col-span-6 reveal">
        <p class="slugline mb-3">Teaching</p>
        <div class="rule-bold mb-6"></div>
        <p class="font-mono text-xs text-muted mb-1">2024 – Present · University of Connecticut</p>
        <h3 class="font-serif text-xl font-bold mb-2">Teaching Assistant</h3>
        <p class="text-accent text-sm italic mb-3">
          EPSY 2810: Creativity — Debunking Myths &amp; Enhancing Innovation
        </p>
        <p class="text-muted text-sm leading-relaxed">
          Undergraduate course with Professor James Kaufman,
          Department of Educational Psychology.
        </p>
      </div>

      <div class="col-span-12 md:col-span-6 reveal reveal-delay-1">
        <p class="slugline mb-3">Awards &amp; Honors</p>
        <div class="rule-bold mb-6"></div>
        <div class="space-y-4">
          {awards.map(a => (
            <div class="flex justify-between items-start">
              <div>
                <p class="font-mono text-xs text-muted mb-1">{a.year}</p>
                <p class="text-sm leading-snug">{a.title}</p>
              </div>
              {a.amount && <p class="font-serif font-bold text-accent flex-shrink-0 ml-4">{a.amount}</p>}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
