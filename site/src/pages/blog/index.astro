---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

// Future posts will go here. Add entries as you write them.
const posts: Array<{
  slug: string;
  date: string;
  category: string;
  title: string;
  excerpt: string;
}> = [
  // Example — uncomment and fill in when you write a post:
  // {
  //   slug:     'ai-creativity-equalizer',
  //   date:     '2025-09-01',
  //   category: 'AI & Creativity',
  //   title:    'Is AI a Great Creative Equalizer?',
  //   excerpt:  'Thoughts on equity, access, and generative tools.',
  // },
];

const comingSoon = [
  { category: 'AI & Creativity',  title: 'Is AI a Great Creative Equalizer?' },
  { category: 'Fan Fiction',      title: 'Why Fan Fiction Is a Researcher\'s Dream Dataset' },
  { category: 'Gifted Education', title: 'Rethinking "Giftedness" in the Age of AI' },
  { category: 'Methods',          title: 'My Workflow for Systematic Reviews' },
];
---

<Layout title="Blog — Eden Wang">
  <Nav />

  <!-- ══════════════════════════════════
       PAGE HEADER
  ══════════════════════════════════ -->
  <section class="pt-32 pb-0 max-w-7xl mx-auto px-6 md:px-10">
    <p class="issue-label text-muted mb-3">Blog · Ideas in Progress</p>
    <div class="rule-bold mb-10"></div>

    <div class="grid grid-cols-12 gap-8 items-end pb-20">
      <div class="col-span-12 md:col-span-7">
        <h1 class="text-display">IDEAS<br /><span class="text-accent italic">IN PRINT</span></h1>
      </div>
      <div class="col-span-12 md:col-span-5">
        <p class="text-subhead text-muted leading-relaxed">
          Reflections on creativity, AI, gifted education,<br />
          and research methodology — as they develop.
        </p>
      </div>
    </div>
  </section>

  {posts.length > 0 ? (
    <!-- Published posts grid -->
    <section class="max-w-7xl mx-auto px-6 md:px-10 pb-24">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-border">
        {posts.map(post => (
          <a href={`/blog/${post.slug}`} class="card-link bg-cream p-8">
            <p class="issue-label text-muted mb-1">{post.date}</p>
            <p class="slugline mb-3">{post.category}</p>
            <h2 class="font-serif text-xl font-bold leading-snug mb-3">{post.title}</h2>
            <p class="text-muted text-sm leading-relaxed">{post.excerpt}</p>
          </a>
        ))}
      </div>
    </section>
  ) : null}

  <!-- ══════════════════════════════════
       COMING SOON
  ══════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 pb-24">
    {posts.length === 0 && (
      <div class="py-20 text-center reveal">
        <p class="font-serif text-4xl font-bold mb-4">Coming Soon</p>
        <p class="text-muted text-sm max-w-md mx-auto leading-relaxed">
          This space is being filled. Check back soon for essays, reflections,
          and ideas from ongoing research.
        </p>
      </div>
    )}

    <div class="rule-bold mb-2 mt-12"></div>
    <p class="issue-label text-muted mb-10">Planned Editions</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-border">
      {comingSoon.map((item, i) => (
        <div class="bg-cream p-8 reveal" style={`transition-delay: ${i * 0.1}s`}>
          <p class="font-mono text-4xl font-bold text-border mb-4 select-none">
            {String(i + 1).padStart(2, '0')}
          </p>
          <p class="slugline mb-3">{item.category}</p>
          <h3 class="font-serif text-xl font-bold leading-snug mb-3">{item.title}</h3>
          <span class="issue-label text-muted border border-border px-3 py-1">Forthcoming</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════
       SUBSCRIBE / NOTIFY CTA
  ══════════════════════════════════ -->
  <section class="bg-teal text-cream py-20">
    <div class="max-w-7xl mx-auto px-6 md:px-10 text-center">
      <p class="slugline text-cream/60 mb-4">Stay Updated</p>
      <h2 class="font-serif text-3xl font-bold mb-4">Want to Know When I Publish?</h2>
      <p class="text-cream/70 text-sm mb-6 max-w-sm mx-auto">
        Send me an email and I'll let you know when new essays are out.
      </p>
      <a
        href="mailto:Shuyu.Wang@uconn.edu?subject=Blog%20Updates"
        class="inline-block border border-cream text-cream px-8 py-3 issue-label hover:bg-cream hover:text-teal transition-all duration-200"
      >
        Get in Touch →
      </a>
    </div>
  </section>

  <Footer />
</Layout>
