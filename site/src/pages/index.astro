---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Eden Wang — Creativity & AI Researcher">
  <Nav />

  <!-- ══════════════════════════════════
       HERO
  ══════════════════════════════════ -->
  <section class="relative min-h-screen flex flex-col justify-center overflow-hidden pt-14">

    <!-- Particle canvas (full-bleed background) -->
    <canvas id="hero-canvas" class="absolute inset-0 w-full h-full opacity-40"></canvas>

    <div class="relative max-w-7xl mx-auto px-6 md:px-10 w-full">

      <!-- Issue label -->
      <p class="issue-label mb-8">Issue 01 · 2025 · Educational Psychology</p>

      <!-- Horizontal rule before display -->
      <div class="rule-bold mb-8"></div>

      <!-- Display headline - asymmetric magazine layout -->
      <div class="grid grid-cols-12 gap-4 items-end mb-8">
        <!-- Large name block -->
        <div class="col-span-12 md:col-span-8">
          <h1 class="text-display text-ink leading-none">
            CREATIVITY<br />
            <span class="text-accent">&</span><br />
            INTELLIGENCE
          </h1>
        </div>

        <!-- Side column - editorial annotation -->
        <div class="col-span-12 md:col-span-4 pb-2 md:pb-4">
          <div class="md:border-l md:border-border md:pl-6">
            <p class="slugline mb-3">The Research of</p>
            <p class="font-serif text-2xl font-bold leading-tight">Shuyu (Eden) Wang</p>
            <p class="text-muted text-sm mt-2 leading-relaxed">
              Ph.D. Candidate<br />
              Educational Psychology<br />
              University of Connecticut
            </p>
          </div>
        </div>
      </div>

      <!-- Rule -->
      <div class="rule mb-8"></div>

      <!-- Subheadline + CTA -->
      <div class="grid grid-cols-12 gap-4 items-center">
        <div class="col-span-12 md:col-span-7">
          <p class="text-subhead text-muted max-w-2xl">
            Exploring how generative AI reshapes creative thinking,
            fan fiction as a window into imagination, and talent development
            in gifted learners.
          </p>
        </div>
        <div class="col-span-12 md:col-span-5 flex gap-6 md:justify-end">
          <a href={`${base}/research`}
             class="issue-label border border-ink px-5 py-3 hover:bg-ink hover:text-cream transition-all duration-200">
            Read Research ↗
          </a>
          <a href={`${base}/about`}
             class="issue-label text-muted hover:text-accent transition-colors duration-200 flex items-center">
            About Eden
          </a>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2">
      <span class="issue-label text-muted">Scroll</span>
      <div class="w-px h-12 bg-border animate-pulse"></div>
    </div>
  </section>

  <!-- ══════════════════════════════════
       EDITORIAL FEATURE GRID
  ══════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 py-24">

    <div class="rule-bold mb-2"></div>
    <p class="issue-label text-muted mb-12">Contents</p>

    <div class="grid grid-cols-12 gap-px bg-border">

      <!-- Feature card — large -->
      <a href={`${base}/research`} class="card-link col-span-12 md:col-span-7 bg-cream p-8 md:p-12">
        <div class="reveal">
          <p class="slugline mb-4">Feature · Research</p>
          <h2 class="text-headline mb-4">
            Can AI Make Us<br />More Creative?
          </h2>
          <p class="text-muted text-sm leading-relaxed max-w-sm mb-6">
            A systematic review and meta-analysis examining how generative
            AI tools affect human creative output — and who benefits most.
          </p>
          <span class="issue-label text-accent">Read Research →</span>
        </div>
      </a>

      <!-- Two small cards stacked -->
      <div class="col-span-12 md:col-span-5 grid grid-rows-2 gap-px">

        <a href={`${base}/about`} class="card-link bg-cream p-8">
          <div class="reveal reveal-delay-1">
            <p class="slugline mb-3">About</p>
            <h3 class="font-serif text-xl font-bold leading-tight mb-3">
              Meet Eden Wang
            </h3>
            <p class="text-muted text-sm leading-relaxed">
              Ph.D. student, teaching assistant, creativity scholar.
            </p>
          </div>
        </a>

        <a href={`${base}/blog`} class="card-link bg-cream p-8">
          <div class="reveal reveal-delay-2">
            <p class="slugline mb-3">Blog</p>
            <h3 class="font-serif text-xl font-bold leading-tight mb-3">
              Ideas in Progress
            </h3>
            <p class="text-muted text-sm leading-relaxed">
              Reflections on AI, creativity, and education — as they develop.
            </p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════
       LATEST WORK SPOTLIGHT
  ══════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 pb-24">
    <div class="rule-bold mb-2"></div>
    <p class="issue-label text-muted mb-12">Latest Work</p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">

      <!-- Publication 1 -->
      <div class="reveal">
        <p class="font-mono text-5xl font-bold text-border mb-4 select-none">01</p>
        <p class="slugline mb-2">Book Chapter · 2026</p>
        <p class="font-serif text-lg font-bold leading-snug mb-3">
          Generative AI's Impact on Creativity and Equity
        </p>
        <p class="text-muted text-xs leading-relaxed">
          Wang, S., Ness, I.J., Greiff, S., & Kaufman, J.C.<br />
          In <em>Generative AI and Creativity</em>. Academic Press.
        </p>
      </div>

      <!-- Publication 2 -->
      <div class="reveal reveal-delay-1">
        <p class="font-mono text-5xl font-bold text-border mb-4 select-none">02</p>
        <p class="slugline mb-2">Presentation · APA 2025</p>
        <p class="font-serif text-lg font-bold leading-snug mb-3">
          How Can GenAI Foster Students' Creativity?
        </p>
        <p class="text-muted text-xs leading-relaxed">
          Wang, S. & Wang, Y.<br />
          APA Division 10 · New Haven, CT
        </p>
      </div>

      <!-- Publication 3 -->
      <div class="reveal reveal-delay-2">
        <p class="font-mono text-5xl font-bold text-border mb-4 select-none">03</p>
        <p class="slugline mb-2">In Preparation</p>
        <p class="font-serif text-lg font-bold leading-snug mb-3">
          Assessing Fan Fiction for Creativity
        </p>
        <p class="text-muted text-xs leading-relaxed">
          Wang, S. & Kaufman, J.C.<br />
          Manuscript in preparation
        </p>
      </div>
    </div>

    <div class="mt-12 rule"></div>
    <div class="mt-6 flex justify-end">
      <a href={`${base}/research`} class="issue-label hover:text-accent transition-colors duration-200">
        Full publication list →
      </a>
    </div>
  </section>

  <!-- ══════════════════════════════════
       RESEARCH INTERESTS — TICKER STRIP
  ══════════════════════════════════ -->
  <div class="bg-ink text-cream py-4 overflow-hidden">
    <div class="ticker-track flex gap-16 whitespace-nowrap">
      {[
        'Creativity & AI',
        'Fan Fiction Studies',
        'Gifted Education',
        'Talent Development',
        'Educational Technology',
        'Systematic Review & Meta-Analysis',
        'Creativity Assessment',
        'Creative Writing',
      ].concat([
        'Creativity & AI',
        'Fan Fiction Studies',
        'Gifted Education',
        'Talent Development',
        'Educational Technology',
        'Systematic Review & Meta-Analysis',
        'Creativity Assessment',
        'Creative Writing',
      ]).map(item => (
        <span class="issue-label text-cream/70 tracking-widest flex-shrink-0">
          ◆ {item}
        </span>
      ))}
    </div>
  </div>

  <Footer />
</Layout>

<!-- Ticker animation -->
<style>
  .ticker-track {
    animation: ticker 30s linear infinite;
  }
  @keyframes ticker {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
</style>

<!-- Particle canvas -->
<script>
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  interface Particle {
    x: number; y: number;
    vx: number; vy: number;
    size: number;
  }

  let particles: Particle[] = [];
  const MAX = 55;
  const LINK_DIST = 130;

  function resize() {
    canvas.width  = canvas.offsetWidth;
    canvas.height = canvas.offsetHeight;
  }

  function init() {
    particles = Array.from({ length: MAX }, () => ({
      x:    Math.random() * canvas.width,
      y:    Math.random() * canvas.height,
      vx:   (Math.random() - 0.5) * 0.35,
      vy:   (Math.random() - 0.5) * 0.35,
      size: Math.random() * 2 + 1,
    }));
  }

  function frame() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    for (const p of particles) {
      p.x += p.vx;
      p.y += p.vy;
      if (p.x < 0 || p.x > canvas.width)  p.vx *= -1;
      if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
    }

    for (let i = 0; i < particles.length; i++) {
      for (let j = i + 1; j < particles.length; j++) {
        const dx = particles[i].x - particles[j].x;
        const dy = particles[i].y - particles[j].y;
        const d  = Math.hypot(dx, dy);
        if (d < LINK_DIST) {
          const a = (1 - d / LINK_DIST) * 0.18;
          ctx.strokeStyle = `rgba(26,23,22,${a})`;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(particles[i].x, particles[i].y);
          ctx.lineTo(particles[j].x, particles[j].y);
          ctx.stroke();
        }
      }
    }

    for (const p of particles) {
      ctx.fillStyle = 'rgba(191,59,44,0.55)';
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      ctx.fill();
    }

    requestAnimationFrame(frame);
  }

  resize();
  init();
  frame();
  window.addEventListener('resize', () => { resize(); init(); });
</script>
